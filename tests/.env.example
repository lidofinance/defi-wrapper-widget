# Required, no default — chain to fork: 1 (mainnet) or 560048 (Hoodi).
CHAIN_ID=

# Optional — Anvil fork source for CHAIN_ID. Falls back to a public no-key RPC;
# a dedicated endpoint is faster and dodges rate limits.
RPC_URL=

# Required — wallet seed phrase. For walletconnect it's the signing EOA
# (mnemonicToAccount index 0), funded on the fork. For metamask it MUST differ
# from Anvil's own mnemonic, or the anvil key import is rejected as duplicate.
TEST_WALLET_SEED_PHRASE=

# Required for metamask / okx only — extension unlock password:
# 8+ chars, 1 digit, 1 symbol.
TEST_WALLET_PASSWORD=

# Optional — walletconnect (default) | metamask | okx, see config/walletConfig.ts.
# walletconnect is headless: no extension, no popup clicks.
WALLET_NAME=walletconnect

# Required for walletconnect — WalletConnect Cloud project id
# (dashboard.reown.com). Read by wallets-testing-wallets' WCWallet and injected
# into the widget build as VITE_WALLETCONNECT_PROJECT_ID (see devServer.ts).
WC_PROJECT_ID=
