# Required — which chain to fork: 560048 (Hoodi) or 1 (mainnet). See
# config/chainConfig.ts's CHAIN_CONFIGS. No default — this is an explicit stand
# switch, not something to leave unset.
CHAIN_ID=560048

# Optional — RPC used as the Anvil fork source for whichever chain CHAIN_ID
# selects. Falls back to a public no-key RPC per chain if unset (see
# config/chainConfig.ts): the suite runs without it, but a dedicated endpoint is
# faster and avoids public rate limits.
RPC_URL=

# Required for every wallet — wallet onboarding seed phrase.
# For WALLET_NAME=walletconnect this is the
# EOA that actually signs transactions (mnemonicToAccount at index 0) — it
# gets funded on the fork in globalSetup, not imported like an extension key.
# For WALLET_NAME=metamask it MUST be a DIFFERENT mnemonic than Anvil's own
# default accounts ("test test test ... junk"), or MetaMask rejects the
# imported anvil test-account private keys as duplicates.
WALLET_SECRET_PHRASE=

# Required for WALLET_NAME=metamask / okx only (unused for walletconnect) —
# the extension unlock password: at least 8 characters, 1 digit, 1 symbol.
WALLET_PASSWORD=

# Optional — defaults to walletconnect.
# walletconnect | metamask | okx — see config/walletConfig.ts.
# walletconnect is headless (no extension download, no popup clicks — the
# WalletConnect SignClient signs automatically) and is the default/preferred
# path for this suite.
WALLET_NAME=walletconnect

# Required for WALLET_NAME=walletconnect only — WalletConnect Cloud project id
# (dashboard.reown.com). Read directly by wallets-testing-wallets'
# WCWallet, and separately injected into the widget build as
# VITE_WALLETCONNECT_PROJECT_ID (see devServer.ts).
WC_PROJECT_ID=
